{
  "opencollection": "1.0.0",
  "info": {
    "name": "Elasticsearch REST Cat Ingest API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ingest",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Simulate ingest pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9200/_ingest/pipeline/:id/_simulate",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Simulate ingest pipeline"
        }
      ]
    }
  ],
  "bundled": true
}